name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - name: Create app files
        run: |
          cat > settings.gradle.kts << 'APPEOF'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = "AppNetCutter"
          APPEOF
          cat > build.gradle.kts << 'APPEOF'
          plugins {
              id("com.android.application") version "8.5.2"
              id("org.jetbrains.kotlin.android") version "1.9.24"
          }

          android {
              namespace = "com.example.appnetcutter"
              compileSdk = 34

              defaultConfig {
                  applicationId = "com.example.appnetcutter"
                  minSdk = 26
                  targetSdk = 34
                  versionCode = 1
                  versionName = "1.0"
              }

              sourceSets {
                  getByName("main") {
                      manifest.srcFile("AndroidManifest.xml")
                      java.srcDirs(".")
                  }
              }

              compileOptions {
                  sourceCompatibility = JavaVersion.VERSION_17
                  targetCompatibility = JavaVersion.VERSION_17
              }
              kotlinOptions {
                  jvmTarget = "17"
              }
          }
          APPEOF
          cat > gradle.properties << 'APPEOF'
          android.useAndroidX=true
          org.gradle.jvmargs=-Xmx2048m
          APPEOF
          cat > AndroidManifest.xml << 'APPEOF'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">

              <uses-permission android:name="android.permission.INTERNET" />
              <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
              <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
              <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

              <queries>
                  <intent>
                      <action android:name="android.intent.action.MAIN" />
                      <category android:name="android.intent.category.LAUNCHER" />
                  </intent>
              </queries>

              <application android:label="App Net Cutter" android:theme="@android:style/Theme.Material.Light">
                  <activity android:name=".MainActivity" android:exported="true">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>

                  <service
                      android:name=".CutterVpnService"
                      android:permission="android.permission.BIND_VPN_SERVICE"
                      android:foregroundServiceType="specialUse"
                      android:exported="false">
                      <intent-filter>
                          <action android:name="android.net.VpnService" />
                      </intent-filter>
                      <property
                          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                          android:value="per-app network testing" />
                  </service>
              </application>
          </manifest>
          APPEOF
          cat > MainActivity.kt << 'APPEOF'
          package com.example.appnetcutter

          import android.app.Activity
          import android.content.Intent
          import android.content.pm.PackageManager
          import android.net.VpnService
          import android.os.Bundle
          import android.view.View
          import android.widget.*

          class MainActivity : Activity() {

              private lateinit var spinner: Spinner
              private val pkgs = mutableListOf<String>()
              private val REQ_VPN = 100

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)

                  val pm = packageManager
                  val launch = Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER)
                  val apps = pm.queryIntentActivities(launch, 0)
                      .map { it.activityInfo.packageName to it.loadLabel(pm).toString() }
                      .distinctBy { it.first }
                      .sortedBy { it.second.lowercase() }
                  pkgs.addAll(apps.map { it.first })

                  spinner = Spinner(this).apply {
                      adapter = ArrayAdapter(this@MainActivity,
                          android.R.layout.simple_spinner_dropdown_item, apps.map { it.second })
                  }
                  val start = Button(this).apply { text = "START (ek click)"; setOnClickListener { onStart() } }
                  val stop = Button(this).apply {
                      text = "STOP"
                      setOnClickListener {
                          startService(Intent(this@MainActivity, CutterVpnService::class.java).setAction("STOP"))
                      }
                  }
                  val root = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      setPadding(48, 96, 48, 48)
                      addView(TextView(this@MainActivity).apply { text = "App select karo:" })
                      addView(spinner); addView(start); addView(stop)
                  }
                  setContentView(root)
              }

              private fun onStart() {
                  val prep = VpnService.prepare(this)
                  if (prep != null) startActivityForResult(prep, REQ_VPN) else launchService()
              }

              override fun onActivityResult(req: Int, res: Int, data: Intent?) {
                  if (req == REQ_VPN && res == RESULT_OK) launchService()
              }

              private fun launchService() {
                  val pkg = pkgs[spinner.selectedItemPosition]
                  startForegroundService(
                      Intent(this, CutterVpnService::class.java).putExtra("pkg", pkg)
                  )
                  Toast.makeText(this, "Started: $pkg", Toast.LENGTH_SHORT).show()
              }
          }
          APPEOF
          cat > CutterVpnService.kt << 'APPEOF'
          package com.example.appnetcutter

          import android.app.*
          import android.content.Intent
          import android.net.VpnService
          import android.os.*

          class CutterVpnService : VpnService() {

              private var tun: ParcelFileDescriptor? = null
              private val handler = Handler(Looper.getMainLooper())
              private var targetPkg: String? = null
              private var running = false

              // 8 sec internet chalega, phir 3 sec cut, phir repeat
              private val workMs = 8000L
              private val cutMs = 3000L

              override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
                  if (intent?.action == "STOP") {
                      stopAll(); return START_NOT_STICKY
                  }
                  targetPkg = intent?.getStringExtra("pkg") ?: return START_NOT_STICKY
                  startForeground(1, buildNotification())
                  running = true
                  handler.removeCallbacksAndMessages(null)
                  handler.postDelayed(cutRunnable, workMs)   // pehle 8 sec normal
                  return START_STICKY
              }

              private val cutRunnable = Runnable { cut() }
              private val restoreRunnable = Runnable { restore() }

              // App ka internet cut: VPN banao jo sirf us app ka traffic pakad ke drop kare
              private fun cut() {
                  if (!running) return
                  try {
                      tun = Builder()
                          .setSession("NetCutter")
                          .addAddress("10.77.0.2", 32)
                          .addRoute("0.0.0.0", 0)
                          .addRoute("::", 0)
                          .addAllowedApplication(targetPkg!!)  // sirf selected app
                          .establish()
                  } catch (e: Exception) { e.printStackTrace() }
                  handler.postDelayed(restoreRunnable, cutMs)
              }

              // VPN band = app wapas normal WiFi use karega
              private fun restore() {
                  tun?.close(); tun = null
                  if (running) handler.postDelayed(cutRunnable, workMs)
              }

              private fun stopAll() {
                  running = false
                  handler.removeCallbacksAndMessages(null)
                  tun?.close(); tun = null
                  stopForeground(STOP_FOREGROUND_REMOVE)
                  stopSelf()
              }

              override fun onRevoke() { stopAll() }
              override fun onDestroy() { stopAll(); super.onDestroy() }

              private fun buildNotification(): Notification {
                  val nm = getSystemService(NotificationManager::class.java)
                  nm.createNotificationChannel(
                      NotificationChannel("cutter", "Net Cutter", NotificationManager.IMPORTANCE_LOW)
                  )
                  return Notification.Builder(this, "cutter")
                      .setContentTitle("Net Cutter running")
                      .setContentText("Target: $targetPkg")
                      .setSmallIcon(android.R.drawable.stat_notify_sync)
                      .build()
              }
          }
          APPEOF
      - name: Build APK
        run: gradle assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: AppNetCutter-apk
          path: build/outputs/apk/debug/*.apk
